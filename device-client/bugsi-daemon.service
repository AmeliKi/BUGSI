[Unit]
Description=BUGSI Device Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bugsi
ExecStart=/opt/bugsi/venv/bin/bugsi run
Restart=always
RestartSec=5
TimeoutStopSec=10
Environment=BUGSI_MOCK_HARDWARE=false
Environment=LIBCAMERA_LOG_LEVELS=*:WARN

[Install]
WantedBy=multi-user.target
