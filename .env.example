# PostgreSQL password
POSTGRES_PASSWORD=bugsi_dev

# REQUIRED: Set to a strong random string (e.g. openssl rand -base64 32)
SECRET_KEY=

# Admin account credentials (ADMIN_PASSWORD must be >= 8 characters)
ADMIN_EMAIL=admin@bugsi.local
ADMIN_PASSWORD=

# Device API key for device-client (get from device registration)
TEST_DEVICE_API_KEY=

# OpenTelemetry (set OTEL_ENABLED=true to export traces to Jaeger)
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Git repository for OTA package building
# HTTPS with PAT (recommended): https://<YOUR_PAT>@dev.azure.com/oh22devops/BUGSI/_git/BUGSI
#   Generate a PAT at: Azure DevOps → User Settings → Personal Access Tokens
#   The PAT needs "Code (Read)" scope
# SSH: git@ssh.dev.azure.com:v3/oh22devops/BUGSI/BUGSI
#   Requires mounting SSH keys: uncomment the SSH volume in docker-compose.yml
GIT_REPO_URL=https://oh22devops@dev.azure.com/oh22devops/BUGSI/_git/BUGSI
GIT_DEVICE_CODE_PATH=device-client/bugsi_daemon
